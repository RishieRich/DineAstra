# Darpan runs fully without any of these. Set them only to have a model
# write the prose; the figures are computed either way.

# Gemini is tried first.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq is tried second.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Force a provider: mock, gemini or groq.
# DARPAN_PROVIDER=mock

# Signs the session token. The default is a published demo value.
# DARPAN_SECRET=
