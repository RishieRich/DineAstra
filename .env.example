# DineAstra is fully usable with blank AI keys. In that mode it uses the
# deterministic, number-checked demo answer bank.

# Gemini is attempted first when a key is present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq is attempted second when a key is present.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional provider override: mock, gemini, or groq.
DARPAN_PROVIDER=mock

# Session-signing secret. Set a long random value before public deployment.
DARPAN_SECRET=

# Postgres connection string. When set, uploaded data is stored in the
# database instead of a local JSON file. Required on Vercel, where the
# filesystem is read-only. Use the POOLED Neon endpoint (the host containing
# "-pooler"), because serverless functions open a connection per invocation.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. Only needed in
# local development, where Vite serves on its own port; on Vercel the app and
# the API share one origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
