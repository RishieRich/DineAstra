{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui/frontend && npm install && npm run build",
  "outputDirectory": "ui/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{ui/frontend/**,tmp/**,outputs/**,tests/**,.venv/**,specs/**,**/__pycache__/**}",
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
